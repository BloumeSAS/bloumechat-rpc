{
  "name": "bloumechat-rpc",
  "displayName": "BloumeChat RPC",
  "description": "Show your Visual Studio Code activity on BloumeChat in real time.",
  "version": "1.0.4",
  "publisher": "BloumeSAS",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "icon.png",
  "author": {
    "name": "BloumeSAS",
    "url": "https://bloume.fr"
  },
  "homepage": "https://bloumechat.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/BloumeSAS/bloumechat-rpc.git"
  },
  "bugs": {
    "url": "https://github.com/BloumeSAS/bloumechat-rpc/issues"
  },
  "qna": false,
  "pricing": "Free",
  "keywords": [
    "bloumechat",
    "rich presence",
    "rpc",
    "activity",
    "status",
    "presence"
  ],
  "galleryBanner": {
    "color": "#6366f1",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "BloumeChat RPC",
      "properties": {
        "bloumechatRpc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable BloumeChat Rich Presence"
        },
        "bloumechatRpc.serverUrl": {
          "type": "string",
          "default": "wss://bloumechat.com",
          "description": "BloumeChat server WebSocket URL"
        },
        "bloumechatRpc.token": {
          "type": "string",
          "default": "",
          "description": "Your BloumeChat RPC token (Settings > Desktop > Token RPC)"
        },
        "bloumechatRpc.showFileName": {
          "type": "boolean",
          "default": true,
          "description": "Show the current file name in your activity"
        },
        "bloumechatRpc.showWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Show the workspace/project name in your activity"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "type-check": "tsc --noEmit",
    "vscode:prepublish": "npm run type-check && node esbuild.js --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "socket.io-client": "^4.7.4"
  }
}
